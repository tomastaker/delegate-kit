#!/usr/bin/env node
// agent-run — start, resume, watch and stop headless workers (Claude Code / Codex CLI)
// with role-based defaults, a JSON result contract, worktree write-locks and a ledger.
// No dependencies. Node >= 20.

import { spawn, spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { roles as ROLES, resolve, readConfig, backendTable, installed } from "./routing.mjs";
import { buildCommand, extractResult } from "./adapters.mjs";
import { inspectPermissions, mergeInline } from "./opencode-permissions.mjs";
import { resolveLimits } from "./limits.mjs";
import { budget } from "./budget.mjs";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const SKILL_DIR = path.resolve(HERE, "..");
const SCHEMA_PATH = path.join(SKILL_DIR, "references", "result-schema.json");
const STATE_DIR = process.env.DELEGATE_KIT_HOME || path.join(os.homedir(), ".delegate-kit");
const RUNS_DIR = path.join(STATE_DIR, "runs");
const LEDGER = path.join(STATE_DIR, "ledger.jsonl");
// Concurrency follows explicit user limits; the host supplies its own capacity.
/*
 * Role-specific timeout safeguards. In the 2026-08-24 ledger, 17 Codex
 * implementer runs had a 17.1-minute median and a 29.3-minute maximum; another
 * hit the old 30-minute limit after committing, during final checks. Reviewers
 * finished in 4–13 minutes. Leave headroom for useful work rather than treating
 * the timeout as a schedule. Individual runs can override it with --timeout.
 */
const ROLE_TIMEOUT_MIN = {
  planner: 90,
  implementer: 90,
  reviewer: 45,
  verifier: 45,
  researcher: 45,
  "review-lead": 45,
};

const CONFIG_FILE = path.join(STATE_DIR, "config.json");
const config = () => readConfig(CONFIG_FILE);
const ROLE_PREAMBLE = {
  planner: "You are a read-only PLANNER. Do not modify files. Produce an ordered plan with files per step, risks, blocking vs non-blocking questions, and the checks that prove completion.",
  implementer: "You are the IMPLEMENTER for exactly this task. Work only inside the current directory (a dedicated git worktree). Run the acceptance checks you can. Commit your work on the current branch with a clear message. If something is ambiguous, stop and return status=blocked with precise questions instead of guessing.",
  reviewer: "You are a read-only REVIEWER. Do not modify files. Review the frozen diff against the spec. Report findings with severity, kind (spec|correctness|standards|nit), file, line, claim, evidence, suggested_fix. Do not restate the diff; do not propose out-of-scope refactors.",
  verifier: "You are a read-only VERIFIER. Decide whether the given finding is confirmed, refuted, or needs-human, with concrete evidence from the code.",
  researcher: "You are a read-only RESEARCHER. Use primary sources; return URLs and dates; a search snippet is not evidence; mark anything you could not open as UNVERIFIED.",
  "review-lead": "You are the read-only REVIEW LEAD. Do not modify files. Before the review: read the spec and the diff stat (not the diff body) and return a plan — one reviewer per step with its lens, files, exclusions, and the brief. After the review: read the reviewers' findings and return one merged, deduplicated, ranked list; mark disputes (one reviewer high, another explicitly fine) for the verifier.",
};
const LENSES = {
  spec: "LENS: spec. Your priority is whether the diff does what the spec asks: missing or partial requirements, behaviour nobody asked for, requirements that look implemented but wrong. Quote the spec line for each finding.",
  correctness: "LENS: correctness. Your priority is whether the code is right: edge cases, error paths, concurrency, data loss, leaks, unupdated callers, contract and schema drift.",
  standards: "LENS: standards. Your priority is whether the code follows this repository's documented conventions and the smell baseline in the brief. A documented repo rule overrides the baseline; skip what tooling already enforces; baseline smells are judgement calls, never hard violations.",
};
const LENS_TAIL = "Report high-severity problems outside your lens too; another reviewer covers the other lenses, but a gap between lenses is worse than a duplicate. Set `lens` on every finding.";
const RESULT_CONTRACT = `\n\nRETURN FORMAT: your final answer must be a single JSON object matching the delegate-kit result schema: {"status":"done|blocked|failed","summary":string,"changes":[{"file","note"}],"checks_run":[string],"not_verified":[string],"plan":[{"step","files","risk"}],"findings":[{"severity","kind","lens","file","line","claim","evidence","suggested_fix","verdict","raised_by"}],"questions":[string],"sources":[{"url","title","date","verified"}],"next_steps":[string]}. Emit every top-level key: use [] for arrays you have nothing for, and null for optional scalars inside items. Do not omit keys — strict output schemas reject partial objects. No prose outside the JSON.`;

// ---------- helpers ----------
/*
 * Detached supervisors discard stderr. A refusal before meta.json exists
 * must persist failed metadata so the waiting parent receives the reason
 * instead of reporting a starting run that was never admitted.
 */
let SUPERVISED = null; // { id, role, backend, model, effort, cwd, write } while running as --_supervise
const die = (msg, code = 1) => {
  process.stderr.write(`agent-run: ${msg}\n`);
  releaseCapsMutex();
  if (SUPERVISED && !fs.existsSync(path.join(runDir(SUPERVISED.id), "meta.json"))) {
    const now = nowIso();
    const result = { status: "failed", summary: `agent-run refused to start the worker: ${msg}`, changes: [], checks_run: [], not_verified: [], findings: [], plan: [], questions: [], sources: [], next_steps: [] };
    fs.mkdirSync(runDir(SUPERVISED.id), { recursive: true });
    saveMeta({ ...SUPERVISED, dispatch: "external", status: "failed", pid: process.pid, started: now, finished: now, error: msg, result });
    writeJson(path.join(runDir(SUPERVISED.id), "result.json"), result);
  }
  process.exit(code);
};
const nowIso = () => new Date().toISOString();
const newId = () => `${new Date().toISOString().replace(/[-:T]/g, "").slice(0, 14)}-${Math.random().toString(36).slice(2, 6)}`;
const readJson = (p, fallback = null) => { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch { return fallback; } };
// tmp + rename: a concurrent reader sees the old file or the new one, never a truncated one
const writeJson = (p, v) => { const tmp = `${p}.${process.pid}.tmp`; fs.writeFileSync(tmp, JSON.stringify(v, null, 2) + "\n"); fs.renameSync(tmp, p); };
const runDir = (id) => path.join(RUNS_DIR, id);
const metaOf = (id) => readJson(path.join(runDir(id), "meta.json"));
const saveMeta = (m) => writeJson(path.join(runDir(m.id), "meta.json"), m);
const alive = (pid) => { try { process.kill(pid, 0); return true; } catch { return false; } };

/*
 * Reconcile persisted status with process liveness. A supervisor killed before
 * its exit handler can leave a run marked running, holding a writer slot and
 * worktree lock indefinitely. All status readers share this reconciliation.
 * Preserve an existing killReason instead of replacing it with orphaned.
 */
function reconcile(m) {
  if (!m || m.status !== "running" || alive(m.pid)) return m;
  m.status = m.killReason || "orphaned";
  m.finished = m.finished || nowIso();
  if (!m.result) {
    m.result = {
      status: "failed",
      summary: m.killReason === "timeout"
        ? `Run stopped after the ${m.timeoutMin}-minute timeout. Work may be partially completed and committed; inspect worktree ${m.cwd} and stdout.log.`
        : `The run supervisor exited without recording a result. Inspect worktree ${m.cwd} and stdout.log.`,
      changes: [], checks_run: [], not_verified: [], findings: [], plan: [], questions: [], sources: [], next_steps: [],
    };
    writeJson(path.join(runDir(m.id), "result.json"), m.result);
  }
  saveMeta(m);
  if (m.write) releaseWriteLock(m.cwd, m.id);
  return m;
}
const sh = (cmd, args, opts = {}) => spawnSync(cmd, args, { encoding: "utf8", ...opts });


function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const k = a.slice(2);
      const next = argv[i + 1];
      if (next === undefined || next.startsWith("--")) out[k] = true; else { out[k] = next; i++; }
    } else out._.push(a);
  }
  return out;
}

function gitDirOf(cwd) {
  const r = sh("git", ["rev-parse", "--git-dir"], { cwd });
  if (r.status !== 0) return null;
  return path.resolve(cwd, r.stdout.trim());
}
function lockPath(cwd) { const g = gitDirOf(cwd); return g ? path.join(g, "delegate-kit.lock") : null; }

function activeRuns() {
  if (!fs.existsSync(RUNS_DIR)) return [];
  return fs.readdirSync(RUNS_DIR).map(metaOf).filter(Boolean).filter((m) => m.status === "running" && alive(m.pid));
}

// Why the worktree cannot take this writer, or null. Checked in the parent before the
// detach fork (so the refusal is visible) and again in the supervisor when it takes the lock.
function writeLockConflict(cwd, id) {
  const lp = lockPath(cwd);
  if (!lp) return `--cwd ${cwd} is not inside a git repository; writers must run in a git worktree`;
  const existing = readJson(lp);
  if (existing && existing.kind === "native" && existing.id !== id) {
    return `worktree is locked for a native subagent (${existing.label || existing.id}, since ${existing.since}). Release it with \`agent-wt release <name>\` when that subagent is done.`;
  }
  if (existing && existing.pid && alive(existing.pid) && existing.id !== id) {
    return `worktree is locked by another writer (run ${existing.id}, pid ${existing.pid}, role ${existing.role}). One writer per worktree.`;
  }
  return null;
}
function acquireWriteLock(cwd, id, role) {
  const conflict = writeLockConflict(cwd, id);
  if (conflict) die(conflict);
  const lp = lockPath(cwd);
  writeJson(lp, { id, role, kind: "process", pid: process.pid, owner: os.userInfo().username, cwd, since: nowIso() });
  return lp;
}
// Native writers hold a lock with no process behind it (`agent-wt lock`); they live at
// <main>/.git/worktrees/<name>/delegate-kit.lock and count toward the writer cap of the repository.
function nativeWriterLocks(cwd) {
  const r = sh("git", ["rev-parse", "--git-common-dir"], { cwd });
  if (r.status !== 0) return [];
  const dir = path.join(path.resolve(cwd, r.stdout.trim()), "worktrees");
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir).flatMap((name) => {
    const l = readJson(path.join(dir, name, "delegate-kit.lock"));
    return l && l.kind === "native" ? [{ name, label: l.label || null, since: l.since || null }] : [];
  });
}

/*
 * Inspect partial work before retrying an interrupted run. The previous worker
 * may have committed or left dirty files before hitting a limit. Compare with
 * the delegate-kit.base saved by agent-wt create; without that base, report
 * only dirty files. agent-run inspect exposes the same snapshot.
 */
function inspectWorktree(cwd) {
  const g = gitDirOf(cwd);
  if (!g) return { cwd, git: false, base: null, commits: [], dirty: [], partial: false, note: null };
  let base = null; try { base = fs.readFileSync(path.join(g, "delegate-kit.base"), "utf8").trim() || null; } catch {}
  const commits = base ? (sh("git", ["log", "--format=%h%x09%s", `${base}..HEAD`], { cwd }).stdout || "").split("\n").filter(Boolean).map((l) => { const [sha, ...rest] = l.split("\t"); return { sha, subject: rest.join("\t") }; }) : [];
  // --untracked-files=all: a new directory is listed file by file, not as one `?? dir/` entry
  const dirty = (sh("git", ["status", "--porcelain", "--untracked-files=all"], { cwd }).stdout || "").split("\n").filter(Boolean).map((l) => ({ status: l.slice(0, 2).trim(), path: l.slice(3) }));
  const partial = commits.length > 0 || dirty.length > 0;
  return { cwd, git: true, base, commits, dirty, partial, note: partial ? previousAttemptNote({ commits, dirty }) : null };
}
function previousAttemptNote({ commits, dirty }) {
  const c = commits.length ? commits.map((x) => `${x.sha} ${x.subject}`).join("; ") : "none";
  const d = dirty.length ? dirty.map((x) => `${x.status} ${x.path}`).join(", ") : "none";
  return `PREVIOUS ATTEMPT: a worker on this same brief stopped mid-run in this worktree. Commits it made since base: ${c}. Uncommitted changes it left: ${d}. Read that work first (git log, git diff) and continue from it: keep what is done, finish what is not, and for the uncommitted changes decide deliberately — keep, finish or revert — and say which in \`summary\`.`;
}
function cmdInspect(cwd) {
  const p = path.resolve(cwd || process.cwd());
  if (!fs.existsSync(p)) die(`no such directory: ${p}`);
  process.stdout.write(JSON.stringify(inspectWorktree(p), null, 2) + "\n");
}

function resolveCaps(opts = {}) { return resolveLimits(opts, config()); }
function cmdBudget(opts) {
  if (!opts.task || opts.task === true) die("budget requires --task ID");
  const result = budget({ stateDir: STATE_DIR, task: opts.task, ticket: opts.ticket,
    retry: opts.retry === true, record: opts.record === true, limits: resolveCaps(opts) });
  console.log(JSON.stringify(result, null, 2));
}
/*
 * Serialize capacity checks and slot reservation. Without a mutex, concurrent
 * starts can all count free capacity before any writes metadata. Exclusive
 * file creation reserves the mutex; a dead holder PID permits recovery.
 * Each supervisor holds its own mutex from admission checks until meta.json
 * is written. A detach parent releases its preliminary lock before spawning it.
 */
const CAPS_MUTEX = path.join(STATE_DIR, "caps.lock");
let capsMutexHeld = false;
function acquireCapsMutex(timeoutMs = 15_000) {
  const deadline = Date.now() + timeoutMs;
  for (;;) {
    try { fs.writeFileSync(CAPS_MUTEX, String(process.pid), { flag: "wx" }); capsMutexHeld = true; return; } catch (e) { if (e.code !== "EEXIST") throw e; }
    let holder; try { holder = Number(fs.readFileSync(CAPS_MUTEX, "utf8").trim() || 0); } catch (e) { if (e.code === "ENOENT") continue; throw e; }
    if (holder && !alive(holder)) { try { fs.rmSync(CAPS_MUTEX, { force: true }); } catch {} continue; }
    if (Date.now() > deadline) die(`another agent-run (pid ${holder}) has held ${CAPS_MUTEX} for ${timeoutMs / 1000}s; if it is stuck, kill it or remove the file`);
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
  }
}
/*
 * The repository mutex is shared with agent-wt lock at
 * <common .git>/delegate-kit.caps.lock. Atomic mkdir serializes native and
 * external writers. Both entry points acquire the global mutex before the
 * repository mutex, maintaining a consistent lock order.
 */
let repoMutexHeld = null;
function acquireRepoMutex(cwd, timeoutMs = 15_000) {
  const r = sh("git", ["rev-parse", "--git-common-dir"], { cwd });
  if (r.status !== 0) return;
  const dir = path.join(path.resolve(cwd, r.stdout.trim()), "delegate-kit.caps.lock");
  const deadline = Date.now() + timeoutMs;
  for (;;) {
    try { fs.mkdirSync(dir); fs.writeFileSync(path.join(dir, "pid"), String(process.pid)); repoMutexHeld = dir; return; } catch (e) { if (e.code !== "EEXIST") throw e; }
    let holder = 0; try { holder = Number(fs.readFileSync(path.join(dir, "pid"), "utf8").trim() || 0); } catch {}
    if (holder && !alive(holder)) { try { fs.rmSync(dir, { recursive: true, force: true }); } catch {} continue; }
    if (Date.now() > deadline) die(`another agent-run or agent-wt (pid ${holder}) has held ${dir} for ${timeoutMs / 1000}s; if it is stuck, kill it or remove the directory`);
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
  }
}
function releaseCapsMutex() {
  if (repoMutexHeld) { const d = repoMutexHeld; repoMutexHeld = null; try { fs.rmSync(d, { recursive: true, force: true }); } catch {} }
  if (!capsMutexHeld) return; capsMutexHeld = false; try { fs.rmSync(CAPS_MUTEX, { force: true }); } catch {}
}

// Refuse before anything is spawned. Native locks (`agent-wt lock`) of the repository of
// cwd count as workers and as writers; external runs count machine-wide.
function checkCaps(caps, write, cwd) {
  const running = activeRuns();
  const native = nativeWriterLocks(cwd);
  if (caps.workers !== null && running.length + native.length >= caps.workers) die(`max ${caps.workers} active workers reached (${[running.length ? `${running.length} external: ${running.map((r) => r.id).join(", ")}` : null, native.length ? `${native.length} native: ${native.map((n) => n.name).join(", ")}` : null].filter(Boolean).join("; ")}). The explicit worker limit is ${caps.workers}; wait for a slot or obtain a revised user limit.`);
  if (!write) return;
  const external = running.filter((r) => r.write);
  const total = external.length + native.length;
  if (caps.writers !== null && total >= caps.writers) {
    const who = [external.length ? `${external.length} external: ${external.map((r) => r.id).join(", ")}` : null, native.length ? `${native.length} native: ${native.map((n) => n.name).join(", ")}` : null].filter(Boolean).join("; ");
    die(`max ${caps.writers} concurrent writers reached (${who}). Respect the explicit user limit (--max-writers N / DELEGATE_KIT_MAX_WRITERS / config.limits.max_writers); wait for a slot.`);
  }
}
function releaseWriteLock(cwd, id) {
  const lp = lockPath(cwd);
  if (!lp) return;
  const existing = readJson(lp);
  if (existing && existing.id === id) fs.rmSync(lp, { force: true });
}

/*
 * ---------- completion delivery (adapted from omp AsyncJobManager) ----------
 * External workers need an explicit completion channel when the host does not
 * provide native notifications. A delivery hook follows the sink pattern in
 * omp's packages/coding-agent/src/async/job-manager.ts.
 *
 * Retry transient hook failures and serialize delivery attempts across the
 * supervisor and list/status/wait/notify callers. The atomic delivery.lock claim
 * prevents concurrent delivery; dead holders can be recovered. See claimDelivery
 * for publication of a fully written claim file.
 *
 * The supervisor drains retries while alive. Subsequent status readers or an
 * explicit notify call handle remaining attempts, without a separate daemon.
 */

const HOOK_TIMEOUT_MS = Number(process.env.DELEGATE_KIT_HOOK_TIMEOUT_MS || 60_000);
const DELIVERY_MAX_ATTEMPTS = 5;
// Delay before attempt N+1 in milliseconds; the array lists retry intervals.
const DELIVERY_BACKOFF_MS = [5_000, 15_000, 45_000, 120_000];
// Supervisor drain budget before polling takes over; covers the first three delays.
const SUPERVISOR_DRAIN_BUDGET_MS = 90_000;

const claimPath = (id) => path.join(runDir(id), "delivery.lock");

/*
 * Lifecycle describes whether a run can be resumed, separately from its stable
 * status contract. A worker process exits after its response; only its saved
 * session transcript survives. Such a session is parked, not idle, and
 * agent-run resume can reopen it.
 */
function lifecycleOf(m) {
  if (!m) return null;
  if (m.status === "running") return "running";
  return m.sessionId ? "parked" : "done";
}

/*
 * Publish a complete claim with link rather than creating an empty file with
 * open(..., "wx") and then writing its PID. A competing reader could mistake
 * the empty file for a dead holder and admit a second delivery. link publishes
 * the prepared file atomically or fails with EEXIST. Treat unreadable claims
 * as occupied until they exceed the hook timeout recovery margin.
 */
function claimDelivery(id) {
  const p = claimPath(id);
  const tmp = `${p}.${process.pid}`;
  for (let i = 0; i < 2; i++) {
    try {
      fs.writeFileSync(tmp, `${process.pid}\n`);
      fs.linkSync(tmp, p);
      fs.rmSync(tmp, { force: true });
      return true;
    } catch (e) {
      fs.rmSync(tmp, { force: true });
      if (e.code !== "EEXIST") return false;
      let holder = 0;
      try { holder = Number(fs.readFileSync(p, "utf8").trim()) || 0; } catch { return false; }
      if (holder && holder !== process.pid && alive(holder)) return false;
      if (!holder) {
        // An unreadable claim may come from an older script. Treat it as occupied
        // until it ages out, allowing recovery without racing a live owner.
        let ageMs = 0;
        try { ageMs = Date.now() - fs.statSync(p).mtimeMs; } catch { return false; }
        if (ageMs < HOOK_TIMEOUT_MS * 2) return false;
      }
      fs.rmSync(p, { force: true }); // Stale claim: the holder died or the claim expired.
    }
  }
  return false;
}
const releaseDelivery = (id) => fs.rmSync(claimPath(id), { force: true });

function deliveryPayload(m, attempt) {
  return {
    id: m.id, role: m.role, backend: m.backend, model: m.model, effort: m.effort,
    status: m.status, worker_status: m.workerStatus ?? null, lifecycle: lifecycleOf(m),
    cwd: m.cwd, started: m.started, finished: m.finished ?? null,
    summary: m.result?.summary ?? null, result: m.result ?? null,
    logs: runDir(m.id), attempt,
  };
}

/*
 * Attempt one delivery. Return "delivered", "failed", or null when no attempt
 * is due: no hook, a live run, prior delivery, backoff, or another claim holder.
 */
function deliverPending(m, opts = {}) {
  if (!m || !m.onFinish) return null;
  if (m.status === "running") return null;
  // A quota-failed attempt leaves completion delivery to its replacement run.
  if (m.status === "failed-quota") return null;
  const d = m.delivery || { state: "pending", attempts: 0, nextAttemptAt: null, lastError: null, deliveredAt: null };
  if (d.state === "delivered" && !opts.force) return null;
  if (d.state === "failed" && !opts.force) return null;
  if (d.nextAttemptAt && Date.parse(d.nextAttemptAt) > Date.now() && !opts.force) return null;
  if (!claimDelivery(m.id)) return null;
  try {
    // Re-read under the claim: another caller may have delivered since our check.
    const fresh = metaOf(m.id);
    if (!fresh || !fresh.onFinish) return null;
    const fd = fresh.delivery || d;
    if (fd.state === "delivered" && !opts.force) return null;
    const attempt = (fd.attempts || 0) + 1;
    const payload = deliveryPayload(fresh, attempt);
    const summary = (payload.summary || "").slice(0, 500);
    // Also expose the payload as a file for hooks that do not read stdin.
    const payloadPath = path.join(runDir(fresh.id), "delivery-payload.json");
    writeJson(payloadPath, payload);
    const r = spawnSync("/bin/sh", ["-c", fresh.onFinish], {
      encoding: "utf8", timeout: HOOK_TIMEOUT_MS, input: JSON.stringify(payload, null, 2),
      env: { ...process.env,
        DK_RUN_ID: fresh.id, DK_ROLE: fresh.role, DK_BACKEND: fresh.backend, DK_MODEL: fresh.model,
        DK_STATUS: fresh.status, DK_WORKER_STATUS: fresh.workerStatus ?? "", DK_LIFECYCLE: payload.lifecycle,
        DK_CWD: fresh.cwd, DK_SUMMARY: summary, DK_RESULT_PATH: path.join(runDir(fresh.id), "result.json"),
        DK_LOGS_DIR: runDir(fresh.id), DK_ATTEMPT: String(attempt), DK_PAYLOAD_PATH: payloadPath,
        DELEGATE_KIT_DEPTH: "", // Hooks are not workers and may launch follow-up workers.
      },
    });
    /*
     * The exit status decides success, including when writing stdin reports EPIPE.
     * A short hook may exit successfully without reading the payload. In the
     * 2026-08-26 fixture, treating that EPIPE as failure retried successful hooks
     * in 26 of 40 rounds. spawnSync still reported the correct exit status.
     */
    const ok = r.status === 0 && (!r.error || r.error.code === "EPIPE");
    const next = { state: "pending", attempts: attempt, nextAttemptAt: null, lastError: null, deliveredAt: fd.deliveredAt ?? null };
    if (ok) { next.state = "delivered"; next.deliveredAt = nowIso(); }
    else {
      next.lastError = String(r.error?.message || `hook exited ${r.status}${r.signal ? ` (${r.signal})` : ""}: ${(r.stderr || "").trim().slice(0, 300)}`);
      if (attempt >= DELIVERY_MAX_ATTEMPTS) next.state = "failed";
      else next.nextAttemptAt = new Date(Date.now() + DELIVERY_BACKOFF_MS[Math.min(attempt - 1, DELIVERY_BACKOFF_MS.length - 1)]).toISOString();
    }
    fresh.delivery = next; saveMeta(fresh);
    return ok ? "delivered" : "failed";
  } finally { releaseDelivery(m.id); }
}

/*
 * Reconcile liveness and attempt delivery whenever a run is read. Reload after
 * delivery because deliverPending updates a fresh metadata copy; otherwise
 * list can report pending for a notification it just delivered.
 */
function touch(m) { const r = reconcile(m); const outcome = deliverPending(r); return outcome ? (metaOf(r.id) || r) : r; }

const sleep = (ms) => new Promise((res) => setTimeout(res, ms));

/*
 * Drain scheduled retries within the supervisor's time budget so an unavailable
 * hook cannot keep the process alive indefinitely.
 */
async function deliverWithRetries(id) {
  const start = Date.now();
  for (;;) {
    const m = metaOf(id);
    if (!m || !m.onFinish) return;
    const outcome = deliverPending(m);
    const d = metaOf(id)?.delivery;
    if (!d || d.state === "delivered" || d.state === "failed") return;
    if (outcome === null && !d.nextAttemptAt) return; // Another process holds the claim.
    const waitMs = d.nextAttemptAt ? Date.parse(d.nextAttemptAt) - Date.now() : 1000;
    if (Date.now() - start + Math.max(waitMs, 0) > SUPERVISOR_DRAIN_BUDGET_MS) return;
    await sleep(Math.max(waitMs, 500));
  }
}

function cmdNotify(argv) {
  const id = argv._[1];
  const force = argv.force === true || argv.force === "true";
  const ids = id ? [id] : (fs.existsSync(RUNS_DIR) ? fs.readdirSync(RUNS_DIR).sort() : []);
  if (id && !metaOf(id)) die(`unknown run ${id}`);
  const rows = [];
  for (const rid of ids) {
    const m = reconcile(metaOf(rid));
    if (!m || !m.onFinish) continue;
    const before = m.delivery?.state ?? "pending";
    const outcome = deliverPending(m, { force });
    const after = metaOf(rid)?.delivery ?? null;
    if (outcome === null && !force && before === after?.state && !id) continue;
    rows.push({ id: rid, role: m.role, status: m.status, lifecycle: lifecycleOf(m), delivery: after });
  }
  process.stdout.write(JSON.stringify(rows, null, 2) + "\n");
}

function resolveRoute(opts = {}) {
  const cfg = config();
  const table = backendTable(cfg);
  const route = resolve(opts, cfg);
  const invocation = ["agent-run", "run", "--role", route.role,
    "--family", route.family, "--runner", route.external_adapter || route.adapter];
  if (route.backend && Object.hasOwn(table, route.backend)) invocation.push("--backend", route.backend);
  if (route.parent) invocation.push("--parent", route.parent);
  if (route.profile) invocation.push("--profile", route.profile);
  if (route.level) invocation.push("--level", String(route.level));
  if (opts.families) invocation.push("--families", String(opts.families));
  else if (route.allowed_families.every(family => route.allowed_backends.some(id => table[id]?.family === family)))
    invocation.push("--families", route.allowed_backends.join(","));
  if (opts.mode) invocation.push("--mode", String(opts.mode));
  if (route.model) invocation.push("--model", route.model);
  if (route.effort) invocation.push("--effort", route.effort);
  if (route.author) invocation.push("--author-backend", route.author);
  for (const key of ["task", "ticket", "max-runs", "max-retries", "max-workers", "max-writers"])
    if (opts[key] !== undefined) invocation.push(`--${key}`, String(opts[key]));
  if (opts.retry === true) invocation.push("--retry");
  invocation.push("--brief", "<brief.md>");
  if (route.write) invocation.push("--cwd", "<worktree>");
  const native = { how: "native", harness: route.adapter,
    role: `dk-${route.role}`, ...(route.model ? { model: route.model } : {}),
    ...(route.effort ? { reasoning_effort: route.effort } : {}),
    note: "Use the host's actual dispatch schema. Omit model/effort for inheritance. Fresh reviewer context; writer worktree lock required." };
  if (route.adapter === "codex") Object.assign(native, { tool: "spawn_agent", agent_type: `dk-${route.role}` });
  if (route.adapter === "claude") Object.assign(native, { tool: "Agent", subagent_type: `dk-${route.role}` });
  return { ...route, invoke: route.dispatch === "native" ? native : { how: "external", argv: invocation,
    note: "Arguments are an array, not shell text. Inspect CLI model configuration when model_source is cli-default." } };
}

const DEPTHS = ["single", "panel", "led"];
const DEPTH_RULES = {
  panel: { lines: 400, files: 10, modules: 2 },  // at or above any of these, or any risk zone
  led:   { lines: 1200, files: 25, modules: 3 }, // at or above any of these, or a risk zone with >= panel.lines
};
const RISK_RE = /auth|session|token|secret|credential|crypt|password|permission|acl|rbac|payment|billing|invoice|tariff|migration|schema|\.env|prod|deploy|infra/i;
const NOISE_RE = /(^|\/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|Cargo\.lock|go\.sum|poetry\.lock)$|(^|\/)(dist|build|vendor|node_modules|__generated__|generated)\/|\.(snap|min\.js|map)$/;

function diffStats(diffPath) {
  if (!fs.existsSync(diffPath)) die(`diff not found: ${diffPath}`);
  const text = fs.readFileSync(diffPath, "utf8");
  const files = new Set(), noise = new Set(), risk = new Set();
  let added = 0, removed = 0, cur = null, curNoise = false;
  for (const line of text.split("\n")) {
    const m = line.match(/^diff --git a\/(.+?) b\/(.+)$/);
    if (m) { cur = m[2]; curNoise = NOISE_RE.test(cur); (curNoise ? noise : files).add(cur); if (!curNoise && RISK_RE.test(cur)) risk.add(cur); continue; }
    if (!cur || curNoise) continue;
    if (/^\+\+\+|^---/.test(line)) continue;
    if (line[0] === "+") { added++; if (RISK_RE.test(line)) risk.add(cur); }
    else if (line[0] === "-") removed++;
  }
  // a module is the first path segment, or the second under a workspace-style root
  const moduleOf = (f) => { const seg = f.split("/"); return /^(packages|apps|services|libs|modules|src)$/.test(seg[0]) && seg.length > 2 ? `${seg[0]}/${seg[1]}` : seg[0]; };
  const modules = new Set([...files].map(moduleOf));
  return { lines: added + removed, added, removed, files: files.size, modules: [...modules], risk_zones: [...risk], noise_files: [...noise] };
}

function suggestDepth(stats, kind) {
  if (kind === "mechanical") return { depth: "single", because: "mechanical diff (formatting, lockfile, generated) — size means nothing here" };
  const r = DEPTH_RULES, risk = stats.risk_zones.length > 0, mods = stats.modules.length;
  if (stats.lines >= r.led.lines || stats.files >= r.led.files || mods >= r.led.modules || (risk && stats.lines >= r.panel.lines))
    return { depth: "led", because: `${stats.lines} lines, ${stats.files} files, ${mods} modules${risk ? `, risk zones: ${stats.risk_zones.slice(0, 3).join(", ")}` : ""}` };
  if (stats.lines >= r.panel.lines || stats.files >= r.panel.files || mods >= r.panel.modules || risk)
    return { depth: "panel", because: risk ? `risk zone touched: ${stats.risk_zones.slice(0, 3).join(", ")}` : `${stats.lines} lines, ${stats.files} files, ${mods} modules` };
  return { depth: "single", because: `${stats.lines} lines, ${stats.files} files, ${mods} module(s), no risk zone` };
}

function cmdRoute(argv) {
  const base = resolveRoute(argv);
  if (argv.role !== "reviewer" && !argv.depth && !argv.diff) return process.stdout.write(JSON.stringify(base, null, 2) + "\n");
  if (argv.role !== "reviewer") die("--depth and --diff apply to --role reviewer");
  const kind = String(argv.kind || "").toLowerCase() || null;
  const stats = argv.diff && argv.diff !== true ? diffStats(argv.diff) : null;
  const suggested = stats ? suggestDepth(stats, kind) : null;
  let depth = argv.depth && argv.depth !== true ? String(argv.depth) : (suggested ? suggested.depth : "single");
  if (!DEPTHS.includes(depth)) die(`--depth must be ${DEPTHS.join("|")} (got ${depth})`);
  const author = base.author;
  const cfg = config();
  const table = backendTable(cfg);
  const lenses = kind === "refactor" ? ["correctness", "standards", "spec"] : ["correctness", "spec", "standards"];
  const count = depth === "single" ? 1 : depth === "panel" ? 2 : 3;
  const alternate = base.allowed_backends.find(b => table[b].family !== base.family && (b === base.parent || installed(table[b].adapter)));
  const reviewers = lenses.slice(0, count).map((lens, i) => {
    // A hard reviewer assignment applies to every slot. Soft preferences do not prevent diversity.
    const backend = i % 2 && !base.candidates?.length && !cfg.roles?.reviewer?.backend && !argv.backend ? alternate || base.backend : base.backend;
    const rr = base.candidates?.length ? base : resolveRoute({ ...argv, role: "reviewer", backend, model: i && backend !== base.backend ? undefined : argv.model,
      effort: i && backend !== base.backend ? undefined : argv.effort, depth: undefined, diff: undefined });
    return { slot: "ABC"[i], lens, ...rr };
  });
  const lead = depth === "led" ? (() => { const l = resolveRoute({ ...argv, role: "review-lead", backend: undefined, family: undefined, runner: undefined, level: undefined, model: undefined, effort: undefined, depth: undefined, diff: undefined }); return { backend: l.backend, model: l.model, effort: l.effort, dispatch: l.dispatch, invoke: l.invoke }; })() : null;
  const sessions = reviewers.length + (lead ? 2 : 0);
  const out = { role: "reviewer", preset: base.preset, mode: base.mode, parent: base.parent, profile: base.profile, level: base.level, author, depth,
    suggested: suggested ? { depth: suggested.depth, because: suggested.because, overridden: suggested.depth !== depth } : null,
    diff: stats, reviewers, lead, cost_note: `${sessions} read-only session(s): ${reviewers.length} reviewer(s)${lead ? " + lead before and after" : ""}; verifier extra per dispute`,
    merge_rules: depth === "single" ? undefined : [
      "reviewers run in parallel and blind to each other; the merge is a separate step",
      "same finding from two reviewers: merge evidence; agreement alone does not prove correctness",
      "finding from one, silence from the other: coverage, not a dispute",
      "one says high, the other explicitly says fine: dispute — settle by command first, then verifier",
      "dedupe by meaning, not by file:line",
    ],
    ask_user: depth !== "single" && !(argv.depth && argv.depth !== true) && cfg.review?.allow_multiple === false ? "multiple reviewers are disabled by the user; request an explicit exception or use single" : undefined,
  };
  process.stdout.write(JSON.stringify(out, null, 2) + "\n");
}
function cmdPreset(argv) {
  const cfg = config();
  const preset = argv._[1];
  if (!preset) return console.log(JSON.stringify({ config: cfg, backends: backendTable(cfg), file: CONFIG_FILE }, null, 2));
  if (!["auto", "main-claude", "main-codex"].includes(preset)) die("preset must be auto, main-claude or main-codex");
  writeJson(CONFIG_FILE, { ...cfg, preset });
  console.log(JSON.stringify({ preset, saved_to: CONFIG_FILE }));
}
function cmdDoctor() {
  console.log(JSON.stringify({ backends: Object.entries(backendTable(config())).map(([id, b]) => ({ id, ...b,
    cli_installed: installed(b.adapter), authentication: "not checked", actual_model: null })),
    note: "Installed is not authenticated. Use the host's model picker/status to establish available models; no model calls were made." }, null, 2));
}

// ---------- run / resume ----------
async function cmdRun(opts, resumeOf = null) {
  if (process.env.DELEGATE_KIT_DEPTH) die("refusing to start a worker from inside a worker (delegation depth is 1)");
  const role = resumeOf ? resumeOf.role : opts.role;
  if (!role || !ROLES[role]) die(`--role must be one of ${Object.keys(ROLES).join("|")}`);
  if (opts.fallback && opts.fallback !== "none") die("Automatic fallback was removed; inspect partial work and choose an authorized executor explicitly");
  // Resume preserves the saved adapter/family/model even if current routing preferences changed.
  const resumeConfig = resumeOf ? { backends: { [resumeOf.backend]: { family: resumeOf.family || (resumeOf.backend === "codex" ? "gpt" : resumeOf.backend), adapter: resumeOf.adapter || resumeOf.backend } } } : null;
  const route = resumeOf ? { ...resumeOf, preset: resumeOf.preset || "auto", dispatch: "external", model_source: "resume", allowed_backends: [resumeOf.backend] }
    : resolveRoute({ ...opts, role, _run: true, external: true });
  const backend = resumeOf ? resumeOf.backend : route.backend;
  const model = resumeOf ? (opts.model && opts.model !== true ? opts.model : resumeOf.model) : route.model;
  const effort = resumeOf ? (opts.effort && opts.effort !== true ? opts.effort : resumeOf.effort) : route.effort;
  // `run` is always an external worker. If the parent could have spawned this one natively,
  // say so once — the cheap path is a real choice, not an accident.
  if (!resumeOf && route.dispatch === "native" && !opts["no-route-hint"]) {
    process.stderr.write(`agent-run: the ${route.parent} parent could run this ${backend} ${role} as a native subagent (${route.invoke.subagent_type || route.invoke.agent}); running it as an external session instead.\n`);
  }
  if (resumeOf && ["model", "effort", "level", "profile", "family", "runner", "backend", "parent", "parent-model", "native-families", "no-native", "external"].some(key => opts[key] !== undefined))
    die("resume keeps the original model, effort and executor; start a fresh run to change them");
  const adapter = route.adapter || resumeConfig?.backends[backend].adapter;
  const family = route.family || resumeConfig?.backends[backend].family;
  const cwd = path.resolve(opts.cwd || (resumeOf ? resumeOf.cwd : process.cwd()));
  const write = opts.write === true ? true : opts.write === "false" ? false : ROLES[role].write;
  if (!fs.existsSync(cwd)) die(`cwd does not exist: ${cwd}`);
  if (write && !resumeOf && !opts["allow-main-checkout"]) {
    const g = gitDirOf(cwd);
    // writers belong in worktrees: .git dir of a linked worktree lives under <main>/.git/worktrees/<name>
    if (g && !/[\\/]\.git[\\/]worktrees[\\/]/.test(g) && !/\.worktrees[\\/]/.test(cwd)) die(`writers must run in a git worktree (use agent-wt create). Pass --allow-main-checkout to override deliberately.`);
  }
  let prompt = opts.prompt;
  if (!prompt && opts.brief) { if (!fs.existsSync(opts.brief)) die(`brief not found: ${opts.brief}`); prompt = fs.readFileSync(opts.brief, "utf8"); }
  if (!prompt) die("provide --brief FILE or --prompt TEXT");
  const lens = opts.lens && opts.lens !== true ? String(opts.lens) : null;
  if (lens && !LENSES[lens]) die(`--lens must be ${Object.keys(LENSES).join("|")} (got ${lens})`);
  if (lens && role !== "reviewer") die("--lens applies to --role reviewer only");
  const lensText = lens ? `${LENSES[lens]} ${LENS_TAIL}\n\n` : "";
  prompt = (resumeOf ? "" : `${ROLE_PREAMBLE[role]}\n\n${lensText}`) + prompt + RESULT_CONTRACT;
  const timeoutMin = Number(opts.timeout ?? ROLE_TIMEOUT_MIN[role] ?? 60);
  if (!Number.isFinite(timeoutMin) || timeoutMin <= 0 || opts.timeout === true) die("--timeout requires a positive number of minutes");
  const onFinishRaw = opts["on-finish"] ?? (resumeOf ? resumeOf.onFinish : null);
  if (onFinishRaw === true) die(`--on-finish needs a shell command, e.g. --on-finish 'echo "$DK_ROLE $DK_STATUS" >> ~/dk-done.log'`);
  const onFinish = onFinishRaw ? String(onFinishRaw) : null;

  // Validate adapter arguments before reserving locks or starting a detached supervisor.
  const id = opts.id || newId();
  const agentName = resumeOf?.agentName || `delegate-kit-${id}`;
  if (opts._supervise) SUPERVISED = { id, role, backend, model, effort, cwd, write };
  const permissionRules = adapter === "opencode" ? inspectPermissions({ cwd, agentName, model }) : undefined;
  const built = buildCommand({ adapter, model, effort, prompt, write, resumeId: resumeOf?.sessionId, skillDir: SKILL_DIR, agentName, permissionRules });
  const inlineConfig = built.config ? mergeInline(built.config) : null;
  const caps = resolveCaps(opts);
  const task = opts.task ?? resumeOf?.task;
  const ticket = opts.ticket ?? resumeOf?.ticket ?? undefined;
  if (resumeOf?.task && task !== resumeOf.task) die("resume keeps its task budget; start a new task deliberately");
  if (resumeOf?.ticket && ticket !== resumeOf.ticket) die("resume keeps its ticket retry count");
  const budgetArgs = { stateDir: STATE_DIR, task, ticket, retry: opts.retry === true, limits: caps };
  budget(budgetArgs);
  // Each process owns its admission locks; preflight never relies on a parent lock.
  acquireCapsMutex(); if (write) acquireRepoMutex(cwd);
  checkCaps(caps, write, cwd);
  if (write) { const conflict = writeLockConflict(cwd, null); if (conflict) die(conflict); }

  if (opts.detach && !opts._supervise) {
    const args = process.argv.slice(2).filter((a) => a !== "--detach");
    args.push("--_supervise", "--id", id);
    releaseCapsMutex();
    const sup = spawn(process.execPath, [fileURLToPath(import.meta.url), ...args], { detached: true, stdio: "ignore", cwd: process.cwd(), env: process.env });
    sup.unref();
    // wait briefly for meta.json so the caller can see the run
    const deadline = Date.now() + (adapter === "opencode" ? 25000 : 5000);
    while (Date.now() < deadline && !fs.existsSync(path.join(runDir(id), "meta.json"))) { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100); }
    const m = metaOf(id);
    releaseCapsMutex();
    if (m && m.status === "failed" && m.error) die(`detached run ${id} did not start: ${m.error}`);
    process.stdout.write(JSON.stringify({ id, role, backend, model, effort, cwd, status: m ? m.status : "starting", supervisor_pid: sup.pid }) + "\n");
    return;
  }

  // Re-check inside the supervisor: another run may have taken a slot since the parent looked.
  checkCaps(caps, write, cwd);
  const taskBudget = budget({ ...budgetArgs, record: true });
  fs.mkdirSync(runDir(id), { recursive: true });
  const outFile = path.join(runDir(id), "last-message.txt");
  built.args = built.args.map((a) => (a === "__OUT__" ? outFile : a));
  const panel = opts.panel && opts.panel !== true ? String(opts.panel) : null;
  const meta = { id, task: task || null, ticket: ticket || null, retry: opts.retry === true, taskBudget, profile: route.profile || null, level: route.level || null, role, backend, family, adapter, agentName: adapter === "opencode" ? agentName : null, model, modelSource: route.model_source, actualModel: null, effort, cwd, write, preset: route.preset, dispatch: "external", lens, panel, status: "running", pid: null, started: nowIso(), resumeOf: resumeOf?.id ?? null, sessionId: resumeOf?.sessionId ?? null, timeoutMin, onFinish, delivery: onFinish ? { state: "pending", attempts: 0, nextAttemptAt: null, lastError: null, deliveredAt: null } : null };
  if (write) meta.lock = acquireWriteLock(cwd, id, role);
  fs.writeFileSync(path.join(runDir(id), "prompt.md"), prompt);

  const stdoutPath = path.join(runDir(id), "stdout.log");
  const stderrPath = path.join(runDir(id), "stderr.log");
  const child = spawn(built.cmd, built.args, { cwd, detached: true, stdio: ["ignore", fs.openSync(stdoutPath, "w"), fs.openSync(stderrPath, "w")],
    env: { ...process.env, ...(inlineConfig ? { OPENCODE_CONFIG_CONTENT: inlineConfig, OPENCODE_AUTO_SHARE: "false" } : {}), DELEGATE_KIT_DEPTH: "1", DELEGATE_KIT_RUN_ID: id } });
  meta.pid = child.pid; saveMeta(meta);
  releaseCapsMutex();
  child.unref();

  const finish = (code, signal) => {
    const m = metaOf(id); if (!m || m.status !== "running") return;
    const stdout = fs.readFileSync(stdoutPath, "utf8");
    const ex = extractResult(adapter, stdout, outFile, JSON.parse(fs.readFileSync(SCHEMA_PATH, "utf8")));
    m.actualModel = ex.actualModel;
    m.status = signal === "SIGKILL" && m.killReason ? m.killReason : code === 0 && !ex.error ? "finished" : "failed";
    m.exitCode = code; m.finished = nowIso(); m.sessionId = ex.sessionId ?? m.sessionId; m.usage = ex.usage ?? null; m.cost_usd = ex.cost_usd ?? null;
    m.result = ex.result ?? { status: "failed", summary: `worker exited with code ${code}; see stderr.log` };
    if (m.result && m.result.status) m.workerStatus = m.result.status;
    if (write) { releaseWriteLock(cwd, id); delete m.lock; }
    saveMeta(m); writeJson(path.join(runDir(id), "result.json"), m.result);
    fs.appendFileSync(LEDGER, JSON.stringify({ id, task: m.task, ticket: m.ticket, profile: m.profile, level: m.level, role, backend, family, adapter, model, actual_model: m.actualModel, model_source: m.modelSource, effort, preset: m.preset ?? null, dispatch: "external", lens: m.lens ?? null, panel: m.panel ?? null, cwd, write, started: m.started, finished: m.finished, duration_s: Math.round((Date.parse(m.finished) - Date.parse(m.started)) / 1000), status: m.status, worker_status: m.workerStatus ?? null, usage: m.usage, cost_usd: m.cost_usd, sessionId: m.sessionId, fallback_from: m.fallbackFrom ?? null }) + "\n");
  };

  /*
   * Persist the timeout reason before killing the process group. If the supervisor
   * never reaches its exit handler, reconcile can still reconstruct result.json.
   * Signal the group with -pid, falling back to the child PID when setsid did not
   * create that group and the first signal fails with ESRCH.
   */
  const timer = setTimeout(() => {
    const m = metaOf(id);
    if (!m || m.status !== "running") return;
    m.killReason = "timeout"; saveMeta(m);
    try { process.kill(-child.pid, "SIGKILL"); } catch { try { process.kill(child.pid, "SIGKILL"); } catch {} }
  }, timeoutMin * 60_000);
  child.on("error", async (error) => {
    clearTimeout(timer);
    fs.appendFileSync(stderrPath, `Unable to start ${adapter}: ${error.code || "spawn error"}\n`);
    finish(1, null);
    await deliverWithRetries(id);
    if (!opts._supervise) printResult(id);
    process.exit(1);
  });
  child.on("exit", async (code, signal) => {
    clearTimeout(timer); finish(code, signal);
    const m = metaOf(id);
    // Switching providers/model after partial writes is a coordinator decision, never a hidden retry.
    await deliverWithRetries(id);
    if (!opts._supervise) printResult(id); process.exit(m.status === "finished" && m.workerStatus !== "failed" ? 0 : 1);
  });

  if (opts.detach) {
    // cmdRun was re-invoked as a detached supervisor; the caller already returned
    return;
  }
}

function printResult(id) {
  const m = touch(metaOf(id)); if (!m) die(`unknown run ${id}`);
  const out = { id: m.id, task: m.task || null, ticket: m.ticket || null, profile: m.profile || null, level: m.level || null, role: m.role, backend: m.backend, family: m.family, adapter: m.adapter, model: m.model, actual_model: m.actualModel ?? null, model_source: m.modelSource, effort: m.effort, lens: m.lens ?? undefined, panel: m.panel ?? undefined, cwd: m.cwd, status: m.status, lifecycle: lifecycleOf(m), delivery: m.delivery ?? undefined, fallback_from: m.fallbackFrom ?? undefined,
worker_status: m.workerStatus ?? null, sessionId: m.sessionId ?? null, usage: m.usage ?? null, cost_usd: m.cost_usd ?? null, started: m.started, finished: m.finished ?? null, result: m.result ?? null, logs: runDir(id) };
  process.stdout.write(JSON.stringify(out, null, 2) + "\n");
}

function cmdList() {
  if (!fs.existsSync(RUNS_DIR)) return console.log("[]");
  const rows = fs.readdirSync(RUNS_DIR).sort().map(metaOf).filter(Boolean).map(touch).map((m) => {
    return { id: m.id, role: m.role, backend: m.backend, model: m.model, effort: m.effort, status: m.status, lifecycle: lifecycleOf(m), worker_status: m.workerStatus ?? null, delivery: m.delivery ? m.delivery.state : undefined, cwd: m.cwd, started: m.started, finished: m.finished ?? null };
  });
  console.log(JSON.stringify(rows, null, 2));
}
async function cmdWait(id, timeoutMin) {
  const deadline = Date.now() + Number(timeoutMin || 60) * 60_000;
  for (;;) {
    const m = metaOf(id); if (!m) die(`unknown run ${id}`);
    if (m.status !== "running") return printResult(id);
    /*
     * Allow the supervisor's exit handler to write status and result.json before
     * reconciling a dead child, avoiding a false orphan report in that window.
     */
    if (!alive(m.pid)) { await new Promise((r) => setTimeout(r, 1500)); return printResult(id); }
    if (Date.now() > deadline) die("wait timed out", 124);
    await new Promise((r) => setTimeout(r, 2000));
  }
}
function cmdKill(id) { const m = metaOf(id); if (!m) die(`unknown run ${id}`); if (m.status !== "running") return printResult(id); m.killReason = "killed"; saveMeta(m); try { process.kill(-m.pid, "SIGTERM"); } catch {} setTimeout(() => { try { process.kill(-m.pid, "SIGKILL"); } catch {} const m2 = metaOf(id); if (m2.status === "running") { m2.status = "killed"; m2.finished = nowIso(); saveMeta(m2); if (m2.write) releaseWriteLock(m2.cwd, id); } printResult(id); }, 3000); }
function cmdLog(id, which = "stdout") { const p = path.join(runDir(id), which === "err" ? "stderr.log" : which === "prompt" ? "prompt.md" : "stdout.log"); if (!fs.existsSync(p)) die(`no log for ${id}`); process.stdout.write(fs.readFileSync(p, "utf8")); }

// ---------- main ----------
async function main() {
const argv = parseArgs(process.argv.slice(2));
const sub = argv._[0];
fs.mkdirSync(RUNS_DIR, { recursive: true });
switch (sub) {
  case "run": await cmdRun(argv); break;
  case "route": cmdRoute(argv); break;
  case "preset": cmdPreset(argv); break;
  case "doctor": cmdDoctor(); break;
  case "budget": cmdBudget(argv); break;
  case "resume": { const prev = metaOf(argv._[1]); if (!prev) die(`unknown run ${argv._[1]}`); if (!prev.sessionId) die(`run ${argv._[1]} has no session id to resume`); await cmdRun({ ...argv, cwd: argv.cwd || prev.cwd }, prev); break; }
  case "list": cmdList(); break;
  case "status": printResult(argv._[1]); break;
  case "wait": await cmdWait(argv._[1], argv.timeout); break;
  case "kill": cmdKill(argv._[1]); break;
  case "log": cmdLog(argv._[1], argv._[2]); break;
  case "notify": cmdNotify(argv); break;
  case "inspect": cmdInspect(argv._[1]); break;
  default:
    console.log(`agent-run — coordinator profiles, role ladders and isolated workers

  route --role ROLE [--parent BACKEND] [--parent-model MODEL]
        [--profile NAME] [--level N] [--family FAMILY] [--runner auto|native|codex|claude|gemini|opencode]
        [--native-families FAMILY,FAMILY] [--no-native]
        [--mode auto|solo|duo] [--families BACKEND,BACKEND]
        [--backend BACKEND] [--model MODEL] [--effort E] [--external]
        [--author-backend BACKEND|self] [--kind ui|refactor|mechanical]
        [--diff FILE] [--depth single|panel|led]
  run --role ROLE (--brief FILE | --prompt TEXT) [routing options]
      [--cwd WORKTREE] [--detach] [--timeout MIN]
      [--task ID] [--ticket ID] [--retry] [--max-writers N] [--max-workers N]
      [--max-runs N] [--max-retries N]
      [--lens spec|correctness|standards] [--panel ID] [--on-finish CMD]
  resume ID (--brief FILE | --prompt TEXT) [--detach] [--retry]
  budget --task ID [--record --ticket ID [--retry]] [--max-runs N] [--max-retries N]
  doctor | preset [auto|main-claude|main-codex]
  list | status ID | wait ID [--timeout MIN] | kill ID | log ID [out|err|prompt]
  notify [ID] [--force] | inspect [WORKTREE]

No JSON required: the coordinator supplies its host and known available models.
No pinned model: native roles inherit; external CLIs use their own configuration.
--families lists backend IDs (codex, claude, gemini, kimi, glm or configured profiles).
Auto allows any configured family count. Solo/duo remain optional legacy boundaries.
Fresh-context review always works; cross_family is separate from freshness.
Choose useful reviewer count within user limits; review.allow_multiple=false requires an exception.
External failures do not silently switch models/providers. Resume preserves the saved target.
Kimi/GLM use OpenCode with an explicit provider/model. Credentials stay in the provider CLI.
Read-only adapters may exclude shell tools; the coordinator runs acceptance commands.

No built-in worker cap. Explicit config.limits, CLI and environment limits are enforced.
Native starts/resumes use budget --record; external runs record automatically with --task.
Timeout minutes: ${Object.entries(ROLE_TIMEOUT_MIN).map(([r, t]) => `${r} ${t}`).join(", ")}.
--on-finish receives the result on stdin and DK_* metadata; failed delivery is retried.
State: ${STATE_DIR}; configuration: ${CONFIG_FILE}.
See references/routing.md and references/providers.md for contracts and verified CLI details.`);
}
}
main().catch((e) => die(String(e?.stack || e)));
