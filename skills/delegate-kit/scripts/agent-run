#!/usr/bin/env node
// agent-run — start, resume, watch and stop headless workers (Claude Code / Codex CLI)
// with role-based defaults, a JSON result contract, worktree write-locks and a ledger.
// No dependencies. Node >= 20.

import { spawn, spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { roles as ROLES, resolve, readConfig, backendTable, installed } from "./routing.mjs";
import { buildCommand, extractResult } from "./adapters.mjs";
import { inspectPermissions, mergeInline } from "./opencode-permissions.mjs";
import { resolveLimits } from "./limits.mjs";
import { budget } from "./budget.mjs";

const HERE = path.dirname(fileURLToPath(import.meta.url));
const SKILL_DIR = path.resolve(HERE, "..");
const SCHEMA_PATH = path.join(SKILL_DIR, "references", "result-schema.json");
const STATE_DIR = process.env.DELEGATE_KIT_HOME || path.join(os.homedir(), ".delegate-kit");
const RUNS_DIR = path.join(STATE_DIR, "runs");
const LEDGER = path.join(STATE_DIR, "ledger.jsonl");
// Concurrency follows explicit user limits; the host supplies its own capacity.
/*
 * Потолок времени на прогон, по ролям.
 *
 * Общие 30 минут на всех оказались впритык именно для пишущих ролей. Замер по
 * ledger на 2026-08-24: 17 прогонов implementer на codex дали медиану 17,1 мин
 * и максимум 29,3 мин — один финишировал за 42 секунды до убийства, а
 * следующий (20260824172835-tv4q) в потолок упёрся и был снят на тридцатой
 * минуте уже после коммита, на финальных проверках. Ревьюеры в тех же данных
 * укладываются в 4-13 минут и запаса не требуют.
 *
 * Потолок здесь — предохранитель от зависшего процесса, а не инструмент
 * планирования: платить за него приходится только в аварии, поэтому запас
 * выбран кратный, а не впритык к наблюдаемому максимуму. Конкретный прогон
 * по-прежнему может задать своё число флагом `--timeout`.
 */
const ROLE_TIMEOUT_MIN = {
