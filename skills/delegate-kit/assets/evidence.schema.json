{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegate Kit verification receipt v1",
  "description": "Runtime-owned result of an actual check. Runtime verifies checkpoint identity, test-count consistency, output artifacts and acceptance requirements; worker-authored JSON is not evidence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "const": "runtime"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "cwd": {
      "type": "string",
      "pattern": "^/"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "\\S"
        },
        "arch": {
          "type": "string",
          "pattern": "\\S"
        },
        "node": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "platform",
        "arch",
        "node"
      ]
    },
    "stdout_path": {
      "type": "string",
      "pattern": "^/"
    },
    "stderr_path": {
      "type": "string",
      "pattern": "^/"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string"
    },
    "snapshot_match": {
      "type": "boolean"
    },
    "tests": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "tests",
        "passed",
        "failed",
        "skipped"
      ]
    },
    "report_path": {
      "type": "string",
      "pattern": "^/"
    }
  },
  "required": [
    "version",
    "id",
    "checkpoint_id",
    "spec_digest",
    "contract_revision",
    "check_id",
    "requirements",
    "source",
    "argv",
    "cwd",
    "started_at",
    "ended_at",
    "environment",
    "stdout_path",
    "stderr_path",
    "exit_code",
    "signal",
    "status",
    "summary",
    "snapshot_match"
  ]
}
