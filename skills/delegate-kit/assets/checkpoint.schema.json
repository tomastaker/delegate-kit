{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegate Kit immutable checkpoint v1",
  "description": "Runtime-owned snapshot identity. Runtime verifies source and frozen Git trees; matching this shape does not prove content integrity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "cwd": {
      "type": "string",
      "pattern": "^/"
    },
    "source_cwd": {
      "type": "string",
      "pattern": "^/"
    },
    "repo": {
      "type": "string",
      "pattern": "^/"
    },
    "base": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "tree": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session": {
      "type": "string",
      "pattern": "\\S"
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "spec_path": {
      "type": "string",
      "pattern": "^/"
    }
  },
  "required": [
    "version",
    "id",
    "cwd",
    "source_cwd",
    "repo",
    "base",
    "tree",
    "spec_digest",
    "contract_revision",
    "session",
    "task",
    "created_at"
  ]
}
