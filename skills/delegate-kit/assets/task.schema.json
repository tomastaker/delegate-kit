{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegate Kit task contract v1",
  "description": "Structural contract validation. Runtime additionally enforces cross-references, unique IDs and resource names, dependency acyclicity, complete review coverage and repository/specification binding.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "session": {
      "type": "string",
      "pattern": "\\S"
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^/"
    },
    "base": {
      "type": "string",
      "pattern": "\\S"
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "goal": {
          "type": "string",
          "pattern": "\\S"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "text": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "text"
            ]
          },
          "minItems": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "digest",
        "goal",
        "requirements",
        "non_goals"
      ]
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "required": {
            "type": "boolean"
          },
          "profile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "defined": {
                "type": "boolean"
              },
              "risk": {
                "enum": [
                  "ordinary",
                  "high"
                ]
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "defined",
              "risk",
              "reason"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!/)(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!/)(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "include",
              "exclude"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "mode": {
                  "enum": [
                    "shared",
                    "exclusive"
                  ]
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name",
                "mode"
              ]
            },
            "minItems": 0
          },
          "max_failed_submissions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "required",
          "profile",
          "routing",
          "scope",
          "dependencies",
          "checks",
          "resources"
        ]
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "pattern": "^(?!/)(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
          },
          "expected_exit": {
            "type": "integer"
          },
          "required": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "report": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?=[\\s\\S]*\\S)[\\s\\S]+$"
              },
              "min_tests": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "min_tests"
            ]
          }
        },
        "required": [
          "id",
          "requirements",
          "argv",
          "cwd",
          "expected_exit",
          "required"
        ]
      },
      "minItems": 0
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "required",
        "profiles",
        "coverage"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "quality": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "finishing": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "integration_owner": {
      "type": "string",
      "pattern": "\\S"
    },
    "trivial": {
      "type": "boolean",
      "description": "Explicitly classify a trivial task; omission means substantial work requires independent review."
    },
    "baseline": {
      "type": "string",
      "pattern": "\\S",
      "description": "Pre-existing failures or unavailable baseline recorded before implementation."
    }
  },
  "required": [
    "version",
    "session",
    "task",
    "repo",
    "base",
    "specification",
    "work_items",
    "checks",
    "review",
    "quality",
    "finishing",
    "integration_owner"
  ]
}
