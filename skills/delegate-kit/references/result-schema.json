{
  "title": "delegate-kit worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "description": "2-6 sentences: what was done or found, and the single most important caveat."
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "checks_run": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commands actually executed and their outcome, e.g. 'pnpm test -- tariffs: 42 passed'."
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "claim"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "spec",
              "correctness",
              "standards",
              "nit"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "confirmed",
              "refuted",
              "needs-human"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Questions for the user; non-empty when status is blocked."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
